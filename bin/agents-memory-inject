#!/usr/bin/env bash
# Build a compact prompt-ready memory packet

set -euo pipefail

AGENTS_ROOT="${AGENTS_ROOT:-$HOME/.agents}"
BRIDGE="$AGENTS_ROOT/scripts/memory-sync-bridge.mjs"

if ! command -v node &>/dev/null; then
  echo "Error: node not found in PATH" >&2
  exit 1
fi

if [[ ! -f "$BRIDGE" ]]; then
  echo "Error: memory bridge not found at $BRIDGE" >&2
  exit 1
fi

exec node "$BRIDGE" inject "$@"
