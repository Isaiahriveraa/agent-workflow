#!/usr/bin/env bash
# Recall memories by workflow stage

set -euo pipefail

AGENTS_ROOT="${AGENTS_ROOT:-$HOME/.agents}"
BRIDGE="$AGENTS_ROOT/scripts/memory-sync-bridge.mjs"

if ! command -v node &>/dev/null; then
  echo "Error: node not found in PATH" >&2
  exit 1
fi

if [[ ! -f "$BRIDGE" ]]; then
  echo "Error: memory bridge not found at $BRIDGE" >&2
  exit 1
fi

STAGE=""
QUERY=""
CONTEXT_SUMMARY=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workflow-stage) STAGE="$2"; shift 2 ;;
    --query) QUERY="$2"; shift 2 ;;
    --context-summary) CONTEXT_SUMMARY="$2"; shift 2 ;;
    create-plan|implement-plan)
      STAGE="$1"
      shift
      ;;
    -h|--help)
      echo "Usage: agents-memory recall <create-plan|implement-plan> [options]"
      echo ""
      echo "Options:"
      echo "  --query <text>         Search query for memory recall"
      echo "  --workflow-stage <stage>  Explicit workflow stage"
      echo "  --context-summary <text>  Context summary for better recall"
      exit 0
      ;;
    *)
      if [[ -z "$STAGE" ]] && [[ "$1" == "create-plan" || "$1" == "implement-plan" ]]; then
        STAGE="$1"
      else
        echo "Error: unrecognized argument '$1'" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$STAGE" ]]; then
  echo "Error: workflow stage required (create-plan|implement-plan)" >&2
  echo "Usage: agents-memory recall <create-plan|implement-plan> [--query <text>]" >&2
  exit 1
fi

CMD=(node "$BRIDGE" recall --workflow-stage "$STAGE")
[[ -n "$QUERY" ]] && CMD+=(--query "$QUERY")
[[ -n "$CONTEXT_SUMMARY" ]] && CMD+=(--context-summary "$CONTEXT_SUMMARY")

"${CMD[@]}"
