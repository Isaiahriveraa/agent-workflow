{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@prototype-kit": ["./src/kit.tsx"],
      "@prototype": ["./template/prototype.tsx"]
    }
  },
  "include": ["src/**/*", "template/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
