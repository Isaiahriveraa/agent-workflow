#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ ! -f "$script_dir/workflow-session.mjs" ]]; then
  script_dir="$HOME/.agents/scripts"
fi

case "${1:-}" in
  sprint|school-learn|school-fast|research|ideation|coding|tutor)
    exec node "$script_dir/workflow-session.mjs" "$@" ;;
  *)
    printf 'Usage: aw sprint|school-learn|school-fast|research|ideation|coding|tutor [--harness pi|claude|codex] [arguments...]\n' >&2
    exit 2
    ;;
esac
