{
  "version": "1.0.0",
  "description": "Centralized AI tool configuration hub — single source of truth for prompts, contexts, commands, rules, skills, agents, and provider adapters across AI coding tools.",
  "hub": "~/.agents",
  "managed_content": {
    "contexts": "~/.agents/contexts",
    "thoughts": "~/.agents/thoughts",
    "skills": "~/.agents/skills",
    "agents": "~/.agents/agents",
    "commands": "~/.agents/commands",
    "hooks": "~/.agents/hooks",
    "adapters": "~/.agents/adapters",
    "rules": "~/.agents/rules",
    "prompts": "~/.agents/prompts",
    "get-shit-done": "~/.agents/get-shit-done"
  },
  "symlinks": [
    {
      "source": "~/.claude/skills",
      "target": "~/.agents/skills",
      "tier": 1,
      "tool": "claude-code",
      "type": "directory"
    },
    {
      "source": "~/.claude/agents",
      "target": "~/.agents/agents",
      "tier": 1,
      "tool": "claude-code",
      "type": "directory"
    },
    {
      "source": "~/.claude/commands",
      "target": "~/.agents/commands",
      "tier": 1,
      "tool": "claude-code",
      "type": "directory"
    },
    {
      "source": "~/.claude/hooks",
      "target": "~/.agents/hooks",
      "tier": 1,
      "tool": "claude-code",
      "type": "directory"
    },
    {
      "source": "~/.claude/get-shit-done",
      "target": "~/.agents/get-shit-done",
      "tier": 1,
      "tool": "claude-code",
      "type": "directory"
    },
    {
      "source": "~/.claude/CLAUDE.md",
      "target": "~/.agents/prompts/system.md",
      "tier": 1,
      "tool": "claude-code",
      "type": "file"
    },
    {
      "source": "~/.codex/AGENTS.md",
      "target": "~/.agents/AGENTS.md",
      "tier": 1,
      "tool": "codex-cli",
      "type": "file"
    },
    {
      "source": "~/.config/opencode/commands",
      "target": "~/.agents/commands",
      "tier": 1,
      "tool": "opencode",
      "type": "directory"
    },
    {
      "source": "~/.gemini/antigravity/skills",
      "target": "~/.agents/skills",
      "tier": 1,
      "tool": "antigravity",
      "type": "directory"
    },
    {
      "source": "~/.openclaw/workspace/skills",
      "target": "~/.agents/skills",
      "tier": 1,
      "tool": "openclaw",
      "type": "directory"
    },
    {
      "source": "~/.openclaw/CLAUDE.md",
      "target": "~/.agents/prompts/system.md",
      "tier": 1,
      "tool": "openclaw",
      "type": "file"
    }
  ],
  "not_managed": [
    "~/.claude/settings.json",
    "~/.claude/hooks.json",
    "~/.codex/config.toml",
    "~/.openclaw/openclaw.json",
    "~/.openclaw/workspace/IDENTITY.md",
    "~/.codex/skills/.system/"
  ],
  "auto_discovery": {
    "opencode_skills": "Auto-discovers from ~/.agents/skills/ — no symlink needed",
    "codex_skills": "Auto-discovers from ~/.agents/skills/ — no symlink needed"
  },
  "generated": [
    {
      "tool": "opencode",
      "target": "~/.config/opencode/agents",
      "source": "~/.agents/agents",
      "type": "adapter-output",
      "generator": "sync.sh gen-opencode-agents",
      "surface": "agents",
      "note": "OpenCode agents are generated from hub agent markdown into OpenCode-compatible frontmatter."
    },
    {
      "tool": "antigravity",
      "target": "~/.gemini/commands",
      "source": "~/.agents/commands",
      "type": "format-bridge",
      "generator": "sync.sh gen-antigravity-commands",
      "surface": "commands",
      "note": "Antigravity requires .toml (description + prompt fields). Hub stores commands as .md with YAML frontmatter. Run 'sync.sh gen-antigravity-commands' or 'sync.sh migrate' to regenerate after hub command changes."
    },
    {
      "tool": "antigravity",
      "target": "~/.gemini/agents",
      "source": "~/.agents/agents",
      "type": "adapter-output",
      "generator": "sync.sh gen-antigravity-agents",
      "surface": "agents",
      "note": "Antigravity agents are generated from the hub agent definitions into Gemini-compatible agent files."
    },
    {
      "tool": "antigravity",
      "target": "~/.gemini/get-shit-done",
      "source": "~/.agents/get-shit-done",
      "type": "adapter-output",
      "generator": "sync.sh gen-antigravity-gsd",
      "surface": "gsd",
      "note": "Get-shit-done content is bridged into Antigravity's local workflow directory."
    },
    {
      "tool": "openclaw",
      "target": "~/.openclaw/workspace",
      "source": "~/.agents",
      "type": "wrapper-output",
      "generator": "sync.sh gen-openclaw-workspace",
      "surface": "workspace-wrappers",
      "outputs": [
        "AGENTS.md",
        "SOUL.md",
        "USER.md",
        "TOOLS.md"
      ],
      "note": "OpenClaw workspace wrappers preserve tool-local identity while pointing back to the hub as the workflow source."
    }
  ]
}
