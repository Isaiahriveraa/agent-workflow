# Copy to `.env` and fill in your values.
# The only supported local backend is `mem0-lancedb`.
# If you previously used `AGENTS_MEMORY_BACKEND=mem0-oss`, migrate to `mem0-lancedb`.
# Your existing Qdrant-stored memories are not automatically migrated.

AGENTS_MEMORY_ENABLED=true
AGENTS_MEMORY_BACKEND=mem0-lancedb
MEM0_TELEMETRY=false

AGENTS_MEMORY_OSS_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENTS_MEMORY_OSS_EMBEDDER_BASE_URL=https://openrouter.ai/api/v1

AGENTS_MEMORY_OSS_LLM_API_KEY=your_openrouter_key
AGENTS_MEMORY_OSS_EMBEDDER_API_KEY=your_openrouter_key
AGENTS_MEMORY_OSS_LLM_MODEL=qwen/qwen3.5-flash-02-23

AGENTS_MEMORY_OSS_HISTORY_DB_PATH=/Users/youruser/.agents/.agents-memory/history.db
# AGENTS_MEMORY_LANCEDB_PATH is optional; derived from AGENTS_MEMORY_OSS_HISTORY_DB_PATH if not set.
# AGENTS_MEMORY_LANCEDB_TABLE_BASE defaults to agents_memory_v1.
