# Copy to `.env` and fill in your OpenRouter key values.

AGENTS_MEMORY_ENABLED=true
AGENTS_MEMORY_BACKEND=mem0-oss
MEM0_TELEMETRY=false

AGENTS_MEMORY_OSS_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENTS_MEMORY_OSS_EMBEDDER_BASE_URL=https://openrouter.ai/api/v1

AGENTS_MEMORY_OSS_LLM_API_KEY=your_openrouter_key
AGENTS_MEMORY_OSS_EMBEDDER_API_KEY=your_openrouter_key
AGENTS_MEMORY_OSS_LLM_MODEL=qwen/qwen3.5-flash-02-23

AGENTS_MEMORY_OSS_VECTORSTORE_URL=http://127.0.0.1:6333
AGENTS_MEMORY_OSS_VECTORSTORE_COLLECTION=agents-memory-v1
AGENTS_MEMORY_OSS_HISTORY_DB_PATH=/Users/isaiahrivera/.agents/.agents-memory/history.db
